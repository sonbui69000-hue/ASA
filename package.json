{
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "4.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "25.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "^31.0.0",
    "prettier": "3.9.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.0",
    "recharts": "3.8.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "name": "vinmec-administrative-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --mode online --outDir dist-online && npm run build:server",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:assistant": "playwright test assistant.spec.ts",
    "test:e2e:demo": "playwright test demo.spec.ts",
    "test:e2e:list": "playwright test --list",
    "test:e2e:legacy": "node scripts/browser-check.mjs",
    "test:qa": "node scripts/qa.mjs",
    "build:server": "vite build --config vite.server.config.ts",
    "server": "npm run build:server && node --env-file-if-exists=.env dist-server/index.js",
    "dev:online": "vite --mode online --host 127.0.0.1 --port 5174 --strictPort",
    "provision:accounts": "npm run build:server && node dist-server/index.js --provision",
    "import:online": "npm run build:server && node dist-server/index.js --import",
    "import:workbooks": "npm run build:server && node dist-server/index.js --import-workbooks",
    "test:server": "vitest run server",
    "build:e2e-server": "vite build --config vite.e2e.config.ts",
    "test:e2e:online": "playwright test --config playwright.online.config.ts",
    "rag:provision": "node scripts/provision-rag-model.mjs",
    "rag:check": "npm run build:server && node --env-file-if-exists=.env dist-server/index.js --rag-check",
    "rag:evaluate": "npm run build:server && node --env-file-if-exists=.env dist-server/index.js --evaluate-rag",
    "test:rag": "vitest run server/rag src/test/rag.test.tsx",
    "ai:evaluate": "npm run build:server && node dist-server/index.js --evaluate-ai",
    "ai:smoke": "npm run build:server && node --env-file-if-exists=.env dist-server/index.js --live-smoke",
    "ai:security": "node --env-file-if-exists=.env scripts/verify-ai-security.mjs"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.1",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
